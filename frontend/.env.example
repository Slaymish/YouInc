# Copy to .env (or .env.local) and fill locally. Never commit real credentials.
# Vite loads these automatically for `pnpm dev`/`pnpm build`/`pnpm start`.

# --- Passkey (WebAuthn) auth -------------------------------------------------
# The whole app is gated behind a passkey session. rpID/origin are derived from
# the incoming request by default, so localhost and a deployed domain both work
# with no config. Override only if a reverse proxy rewrites Host/Origin:
# YOUINC_RP_ID=ledger.example.com
# YOUINC_RP_ORIGIN=https://ledger.example.com

# Set this temporarily to enrol a new passkey via the "Enrol a new passkey"
# form on /login, then UNSET it to disable registration. Leave unset normally.
YOUINC_ENROLLMENT_TOKEN=

# Where the passkey credential + sessions are stored (separate from the ledger).
# YOUINC_AUTH_DB_PATH=../data/youinc-auth.sqlite3

# --- Supabase (self-service signup + multi-tenant auth) ----------------------
# Powers the public self-service flow: /signup, /signin, /onboarding, /workspace.
# These VITE_-prefixed vars are safe to expose to the browser (the anon key is
# gated by Row-Level Security). NEVER put the service_role / secret key here.
#
# Defaults (baked into src/lib/supabaseConfig.ts) point at the local
# `supabase start` stack, so dev works with no config. Set these in production:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
#
# For local dev the defaults match `supabase status`; override only if your
# local stack uses different values:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- Akahu live bank sync (self-service tenants) -----------------------------
# The Akahu APP token is a server-wide secret shared by all tenants; each user
# supplies their own enduring USER token via the /workspace connect form (stored
# encrypted in Supabase Vault, never in the client bundle). Without an app token
# the workspace shows a 'live sync not enabled' note and users can still track
# manual accounts / load sample data.
# AKAHU_APP_TOKEN=app_token_...
# AKAHU_BASE_URL=https://api.akahu.io/v1

# --- Concierge lead capture (optional) ---------------------------------------
# The self-serve tier now signs up directly; the leads store is still used for
# concierge interest. Optional webhook fires on new leads (best-effort):
# YOUINC_LEADS_DB_PATH=../data/youinc-leads.sqlite3
# YOUINC_LEADS_WEBHOOK_URL=
