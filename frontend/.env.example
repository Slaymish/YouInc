# Optional. Copy to frontend/.env.local. No configuration is needed for local use.
# Vite and the production launcher load this file. Never commit real tokens.
# Use an absolute path to keep the database location independent of the launch directory.
# YOUINC_DB_PATH=/absolute/path/to/ledger.sqlite3

# Optional personal bank sync; both tokens are server-only.
# AKAHU_APP_TOKEN=
# AKAHU_USER_TOKEN=
# AKAHU_BASE_URL=https://api.akahu.io/v1

# Public sample-data-only mode. This disables ALL personal database access.
# YOUINC_DEMO=1
