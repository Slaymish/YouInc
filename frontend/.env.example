# Copy to .env (or .env.local) and fill locally. Never commit real credentials.
# Vite loads these automatically for `pnpm dev`/`pnpm build`/`pnpm start`.

# --- Passkey (WebAuthn) auth -------------------------------------------------
# The whole app is gated behind a passkey session. rpID/origin are derived from
# the incoming request by default, so localhost and a deployed domain both work
# with no config. Override only if a reverse proxy rewrites Host/Origin:
# YOUINC_RP_ID=ledger.example.com
# YOUINC_RP_ORIGIN=https://ledger.example.com

# Set this temporarily to enrol a new passkey via the "Enrol a new passkey"
# form on /login, then UNSET it to disable registration. Leave unset normally.
YOUINC_ENROLLMENT_TOKEN=

# Where the passkey credential + sessions are stored (separate from the ledger).
# YOUINC_AUTH_DB_PATH=../data/youinc-auth.sqlite3
