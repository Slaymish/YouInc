# Copy to .env and fill locally. Never commit real credentials.

# Akahu API credentials. Required only for live sync.
# OAuth2 connect flow (replaces manual user-token paste).
# See README for the full setup: app must be upgraded to Full App with OAuth enabled,
# and redirect URIs must be registered on the Akahu dashboard.
AKAHU_APP_TOKEN=
AKAHU_SECRET=
AKAHU_BASE_URL=https://api.akahu.io/v1
# Registered OAuth redirect URI (e.g. http://localhost:3000/api/akahu/callback for local dev)
AKAHU_OAUTH_REDIRECT_URI=
# Optional overrides (leave unset for defaults):
# AKAHU_APP_ID_TOKEN=  (defaults to AKAHU_APP_TOKEN)
# AKAHU_OAUTH_AUTHORIZE_URL=https://oauth.akahu.nz
# AKAHU_OAUTH_SCOPES=ENDURING_CONSENT

# Local persistence defaults.
YOUINC_DB_PATH=./data/youinc-ledger.sqlite3
YOUINC_RULES_PATH=./config/rules.yaml
YOUINC_LEDGER_PATH=./ledger.journal

# Ingestion safety.
YOUINC_DISCARD_PENDING=true
YOUINC_RATE_LIMIT_SECONDS=0.25
