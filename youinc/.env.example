# Personal Akahu credentials. Copy to ../../../.youinc/.env or export them.
# NEVER commit real values. The CLI reads the environment only.
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=
AKAHU_BASE_URL=https://api.akahu.io/v1
# Optional: where the ledger lives (default ~/.youinc/ledger.sqlite3)
# YOUINC_DB_PATH=/Users/you/.youinc/ledger.sqlite3
